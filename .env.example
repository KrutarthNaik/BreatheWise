# ==============================================================================
# BreatheWise Environment Variables Template
# ==============================================================================
# Copy this file to server/.env for local backend development or configure these
# variables in your production hosting platform (Vercel, Render, Railway, etc.).
# NEVER COMMIT REAL API KEYS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Backend Server Port (default: 5000)
PORT=5000

# Google Gemini API Key
# Obtain a free API key at: https://aistudio.google.com
# Leave blank to run the application in grounded Demo Mode without an external key.
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
# Recommended: gemini-2.5-flash (fast, structured JSON support)
# Alternatives: gemini-2.5-flash-lite, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Frontend API URL (for production deployments where frontend and
# backend are hosted on different domains)
# Example: https://breathewise-backend.onrender.com
# VITE_API_URL=
